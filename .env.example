# ── Database ──────────────────────────────────────────────────────────────────
# Postgres connection string (standalone deployment)
DATABASE_URL=postgres://memex:changeme@localhost:5432/memex

# ── Auth — Keycloak ───────────────────────────────────────────────────────────
# Public URL the browser redirects to for login. Use "auto" for LAN/dev so
# /api/config derives http://<current-browser-host>:8080 from the request.
KEYCLOAK_URL=auto
KEYCLOAK_PUBLIC_PORT=8080
# Internal URL for server-to-server JWKS verification (omit if same as above)
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=memex
KEYCLOAK_CLIENT_ID=memex-app

# ── Keycloak admin (docker-compose only) ─────────────────────────────────────
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=changeme
POSTGRES_PASSWORD=changeme

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Admin emails ──────────────────────────────────────────────────────────────
# Comma-separated; these users get the 'admin' role on first login.
# First-deploy bootstrap: the seeded Keycloak user admin@memex.local (temporary
# password "memex-admin", change on first login) is admin out of the box —
# replace with your real admin email(s) for a customer deployment.
ADMIN_EMAILS=admin@memex.local,your@email.com

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── File storage and editing ──────────────────────────────────────────────────
APP_URL=https://your-app-url.com
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}
GOOGLE_DRIVE_FOLDER_ID=optional-folder-id

# Storage provider — local (default), s3, or supabase
STORAGE_PROVIDER=local

# Local filesystem storage (STORAGE_PROVIDER=local). Docker installs ignore this:
# compose fixes the container path at /data/documents, and the HOST directory is
# chosen with MEMEX_DOCS_DIR (below). Set this only for bare non-Docker runs —
# a wrong value here points the app at an unmounted path and files land in the
# container's writable layer, vanishing on the next upgrade.
# STORAGE_LOCAL_PATH=/var/lib/memex/documents

# S3-compatible storage (STORAGE_PROVIDER=s3)
# Works with AWS S3, Cloudflare R2, Backblaze B2, MinIO, DigitalOcean Spaces
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
# Custom endpoint — omit for AWS, set for R2/B2/MinIO/etc.
STORAGE_S3_ENDPOINT=
STORAGE_S3_FORCE_PATH_STYLE=false

# Supabase storage (STORAGE_PROVIDER=supabase — legacy / Supabase-hosted deployments only)
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ── At-rest encryption (local storage only) ───────────────────────────────────
# AES-256-GCM. Provide a 64-char hex key or any passphrase.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Configurable from the admin panel — no restart required.
# WARNING: losing this key makes all encrypted files unrecoverable.
# STORAGE_ENCRYPTION_KEY=

# Backup key escrow (optional but recommended if STORAGE_ENCRYPTION_KEY is set):
# a passphrase used to wrap the encryption key inside each backup, so the key can be
# recovered from a backup without making the backup self-decrypting. Keep it SEPARATE
# from your backups (env-only — it is never written to the database or the archive).
# Recover with: MEMEX_BACKUP_KEY_PASSPHRASE=... node scripts/recover-key.js encryption-key.enc
# MEMEX_BACKUP_KEY_PASSPHRASE=

# ── Network ──────────────────────────────────────────────────────────────────
# Reverse proxy trust (1 = one hop; loopback; linklocal; true = all — not recommended)
# TRUST_PROXY=1
# CORS_ORIGINS=https://app.yourco.com,https://admin.yourco.com
# Extra hostnames the on-demand TLS gate may approve beyond app_url's host.
# TLS_DOMAINS=
# GitHub repo the (signed-in, cached) update check polls for release tags.
# MEMEX_REPO=cdburgess75/Memex
# MAX_UPLOAD_MB=50
# HTTP_PROXY=http://proxy.company.com:8080
# BIND_ADDRESS=0.0.0.0

# -- Rate limiting ------------------------------------------------------------
# Set RATE_LIMIT_ENABLED=false only for trusted internal testing.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_API_MAX=300
# RATE_LIMIT_AUTH_MAX=20

# ── Deployment (docker compose) ───────────────────────────────────────────────
# All of these are written by install.sh; listed here so hand-maintained .envs
# stay complete.
# Deployment mode: public (Caddy + HTTPS, ports bind loopback) or local (LAN,
# plain http). upgrade.sh and ops tooling pick the compose files from this.
# MEMEX_MODE=local
# Image tag the stack runs. upgrade.sh pins this; fleet boxes never run latest.
# MEMEX_TAG=latest
# HOST directory holding the document store (bind-mounted to /data/documents).
# MEMEX_DOCS_DIR=/srv/memex-documents
# HOST directory mounted read-only at /secrets (license.json, Graph cert key).
# MEMEX_SECRETS_DIR=./secrets
# Host bind addresses for the app/Keycloak ports: 127.0.0.1 in public mode
# (Caddy fronts them), blank → 0.0.0.0 in local mode for direct LAN access.
# APP_BIND=
# KC_BIND=
# In-browser Office editing (Collabora). SSL termination must be true when the
# deployment is served over HTTPS (wss), false on plain http.
# COLLABORA_ENABLED=true
# COLLABORA_SSL_TERMINATION=false
# COLLABORA_ADMIN_USER=admin
# COLLABORA_ADMIN_PASSWORD=changeme
# Pinned service images — bump deliberately with a release, not when Docker Hub
# moves `latest`.
# COLLABORA_TAG=26.04.3.1.1
# CADDY_TAG=2.11

# ── Licensing (fleet installs) ────────────────────────────────────────────────
# The verification key ships inside the image (keys/ptech-license-public.pem);
# the per-customer signed license is dropped at $MEMEX_SECRETS_DIR/license.json.
# Override these only for key rotation or non-standard layouts:
# LICENSE_PUBLIC_KEY=
# LICENSE_PUBLIC_KEY_PATH=/app/keys/ptech-license-public.pem
# LICENSE_FILE=/secrets/license.json
# Host command the licensed in-app "Run update now" button executes. Leave unset
# on managed boxes (updates are pushed by the operator); setting it hands the
# app permission to run a shell command — never expose it to untrusted admins.
# MEMEX_UPDATE_COMMAND=
