# Per-customer answers for deploy/provision.sh — copy, fill, deliver to the VM,
# run: sudo ./provision.sh /root/<slug>.answers.env
#
# This file carries live secrets once filled in. In the fleet repo it is stored
# age-encrypted (answers/<slug>.env.age); on the customer VM keep it root-only
# and delete it after a green verification gate.

# ── Identity ─────────────────────────────────────────────────────────────────
CUSTOMER_SLUG=acme
APP_DOMAIN=docs.acme.com
# The site's static WAN IP (hard prerequisite — provisioning aborts if the
# domain's A record doesn't already point here).
STATIC_IP=203.0.113.10

# First app admins. Both get real Keycloak accounts with a one-time temp
# password printed during provisioning; the universal seed admin is disabled.
CUSTOMER_ADMIN_EMAIL=it@acme.com
PARATECH_EMAIL=dave@ptechllc.com

# ── Release ──────────────────────────────────────────────────────────────────
# Pinned release tag (vYYYY.MM.DD.NNN). Never 'latest' on a fleet box.
MEMEX_TAG=v2026.08.25.001

# ── Management overlay ───────────────────────────────────────────────────────
# Short-lived, TAGGED Tailscale auth key (tag:depot — tagged nodes don't expire).
# Mint per provisioning; never reuse or store long-term.
TS_AUTHKEY=tskey-auth-REPLACE
# TS_HOSTNAME=depot-acme            # default: depot-<CUSTOMER_SLUG>

# ── RMM ──────────────────────────────────────────────────────────────────────
# Your RMM's silent-install one-liner for this site, and (optionally) a command
# that exits 0 when the agent is already installed.
RMM_INSTALL_CMD=
RMM_DETECT_CMD=

# ── Secrets ──────────────────────────────────────────────────────────────────
# The signed license for this customer, base64 of license.json:
#   node scripts/sign-license.js payload.json ~/depot-license-keys/ptech-license-private.pem | base64
LICENSE_JSON_B64=REPLACE
# Wraps a recoverable copy of the at-rest encryption key into every backup
# archive. Generate fresh per customer and record it in the fleet password
# manager — it is the files-survive-losing-.env story.
MEMEX_BACKUP_KEY_PASSPHRASE=REPLACE
# Optional: customer's Anthropic key for AI features (blank = skip; the wizard
# can add it later).
ANTHROPIC_API_KEY=

# ── Backup schedule ──────────────────────────────────────────────────────────
# Nightly local staging; Axcient's VM image carries these archives offsite.
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION=7
