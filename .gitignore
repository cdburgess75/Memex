.DS_Store
*.log
node_modules/
memex-backup.json

# Local environment
# Match every .env variant, not just the exact name: a hand-made .env.backup or
# .env.save carries the same live POSTGRES_PASSWORD, KEYCLOAK_ADMIN_PASSWORD and
# STORAGE_ENCRYPTION_KEY, and this repo is public.
.env*
!.env.example
.local-secrets/

# Local tooling (preview launch config, plans)
.claude/

# Per-customer license + operator secrets (mounted into the container read-only)
license.json
secrets/

# Signing/verify keys: keep the directory ignored so a private key dropped here is
# never committed; the public license-verify key is the one deliberate exception.
keys/
!keys/ptech-license-public.pem
